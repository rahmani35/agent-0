# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=europe-west3
GCS_STAGING_BUCKET=gs://your-gcs-staging-bucket-name

# Gemini API Key (if running locally without default application credentials)
GEMINI_API_KEY=your-gemini-api-key

# Model Configuration (e.g. gemini-2.5-flash, gemini-3.7-flash)
MODEL_NAME=gemini-2.5-flash

# Google OAuth & Whitelist Access Control
ALLOWED_USERS=user@example.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Vertex AI Agent Engine Instance
REASONING_ENGINE_ID=projects/YOUR_PROJECT_ID/locations/YOUR_REGION/reasoningEngines/YOUR_ENGINE_ID

# Server Configuration
PORT=8083

# Frontend Google OAuth Client ID (in frontend/.env)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_API_URL=http://localhost:8083
