# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GCS_STAGING_BUCKET=gs://your-gcs-staging-bucket-name

# Gemini API Key (if running locally without default application credentials)
GEMINI_API_KEY=your-gemini-api-key

# Model Configuration (e.g. gemini-3.7-flash, gemini-2.5-flash, gemini-2.0-flash)
MODEL_NAME=gemini-3.7-flash

# Authentication Configuration
AUTH_USERS={"iman.rahmani@gmail.com": "YourSecurePasswordHere"}
JWT_SECRET_KEY=your-random-jwt-secret-key

# Server Configuration
PORT=8000


